# Agent team configuration. Copy to `.agent-team.env` at the repository root
# (it is sourced by every script in scripts/agents and scripts/lead) and edit.
# Every value has a default in scripts/agents/config.sh; set only what differs.

# ---- the project -------------------------------------------------------------
# Display name (Remote Control session names, notifications) and a short
# lowercase slug (systemd unit names, lock files, default directories).
TEAM_PROJECT="My Project"
TEAM_SLUG="myproj"

# The integration branch: base of every agent branch, target of every PR, the
# branch live runs use. Agents never commit to it except claims and backlog edits.
TEAM_BASE="dev"

# The owner's own checkout. Agents never work in it; their worktrees are made
# from it under TEAM_WT_ROOT.
TEAM_MAIN_CHECKOUT="$HOME/src/myproj"

# Where agent worktrees live (one per agent name) and where their state lives
# (handoff, status line, logs) across sessions.
# TEAM_WT_ROOT="$HOME/myproj-wt"
# TEAM_STATE_ROOT="$HOME/.myproj-agents"

# Untracked paths in the main checkout that every worktree needs, linked in
# (secrets, virtualenvs, node_modules). Space-separated, relative to the repo.
TEAM_LINKS=".env .venv node_modules"

# ---- identity ------------------------------------------------------------------
# Every agent pushes as the same GitHub user; each worktree is "signed" so
# `git log --format=%ae` tells the sessions apart: "Name (agent)" and
# user+agent@domain.
TEAM_GIT_NAME="Your Name"
TEAM_GIT_EMAIL="you@example.com"

# ---- tools ---------------------------------------------------------------------
# Python used by the backlog-writing helpers (automerge.sh, train_merge.sh).
# TEAM_PYTHON="python3"
# The only test a coding agent may run on the shared machine: one file, capped.
# TEAM_QUICK_TEST_CMD="python -m pytest -q -x -p no:cacheprovider"
# TEAM_QUICK_TEST_MEM="512M"
# TEAM_QUICK_TEST_TIMEOUT=120
# Claude Code config dir for supervised sessions (leave unset for the default).
# TEAM_CLAUDE_CONFIG_DIR="$HOME/.claude"

# ---- the machine -----------------------------------------------------------------
# Memory cap of the scope a live run's app server runs in, and the lock dir.
# TEAM_SERVER_MEM="10G"
# TEAM_LOCK_DIR="/tmp"
# Optional: a self-hosted CI runner on this same machine. While the PM's live
# server runs, the runner loses this label so other runners take the queue.
# TEAM_LOCAL_RUNNER="my-pc"
# TEAM_RUNNER_LABEL="self-hosted-heavy"

# ---- CI ---------------------------------------------------------------------------
# Check names that do not count as "tests ran" when the guarded merge decides a
# PR is green (a paths-filter job, a labeler...). Space-separated.
# TEAM_CI_IGNORE_CHECKS="changes"

# ---- the team (start_team.sh) -----------------------------------------------------
# TEAM_LEADS="tech-lead tech-lead-2"
# TEAM_PM="pm"
# TEAM_CODERS="c1:L2 c2:L2 c3:L3"
